# Credenciales — nunca al repo
private/
bot-config/

# CMS — lo gestiona el cliente desde admin.html en el servidor (patrón Lawang).
# El sitio tiene fallback estático embebido si falta. NO subir al repo para no
# machacar las ediciones del cliente en cada deploy.
data.json

# Backups locales (cualquier fecha)
Backup_*/
Backups/
# Y cualquier fichero suelto de la raíz cuyo nombre empiece por «Backups»: una copia hecha con la fecha
# sin expandir se queda fuera de la carpeta, y este repo se publica entero.
/Backups*

# Exports del CRM (leads/operadores: PII) — el repo es público, nunca al repo
*.csv

# Trabajo local — no desplegar
scripts/
*.md
# Páginas de prueba sueltas (p. ej. las del Pixel con y sin aviso de cookies): se quedan en el disco de
# quien las hizo. Este repo se publica entero, así que versionarlas las pondría en el dominio.
_test_*.html

# Versiones deprecadas
Deprecated/

# Logos fuente (no necesarios en producción)
Logos/

# Masters / originales de alta resolución (PDF y vídeo sin optimizar) — no desplegar
masters/

# Sistema
.DS_Store
Thumbs.db
desktop.ini
MetaLead/

# Creatividades y planes de campaña (mismo caso que MetaLead/): material de trabajo
# para Meta Ads. Este repo DESPLIEGA en Hostinger, asi que todo lo que entre aqui
# queda publico en balimotoadventures.com — y son 69 MB de PNG que nadie sirve.
Marketing/
