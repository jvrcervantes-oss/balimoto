# ═══════════════════════════════════════════════════════════════════
# Seguridad — Depto. de Seguridad AxisWorks · 15-jul-2026
# Estándar: contexto/seguridad_2026.md §1 (vía estática + JSON + admin)
# Cubre OWASP A02:2025 (Security Misconfiguration) y A03 (Supply Chain).
# ═══════════════════════════════════════════════════════════════════

# ── 1. Cabeceras de seguridad ──────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"

  # CSP en modo REPORT-ONLY: no bloquea nada, solo reporta en la consola
  # del navegador. Inventario de orígenes verificado por grep (15-jul-2026;
  # fuentes y vídeo revisados el 14-oct-2026). Cada origen tiene un llamador:
  #   script  → GA4 (googletagmanager) · Meta Pixel (connect.facebook.net). GSAP se sirve desde
  #             /vendor/gsap/ desde el 14-oct-2026 (antes cdnjs, que cargaba antes de elegir)
  #   style   → solo propias: las fuentes salen de /fonts/fonts.css, ya no de Google
  #   font    → solo propias (/fonts/*.woff2)
  #   connect → frankfurter (divisas) · Apps Script (newsletter) · GA4 · Pixel
  #   frame   → solo www.youtube-nocookie.com: el reproductor del vídeo de portada,
  #             que index.html crea al pulsar la miniatura (data-accion="reproducir-video")
  #   img     → beacons de Pixel/GA4 (las fotos de Unsplash son locales desde el 14-oct-2026). La miniatura del vídeo es
  #             nuestra (images/b2k-video-poster-7islands.webp), no de ytimg
  # GA4 y Pixel solo cargan tras aceptar el aviso de cookies; la CSP los admite
  # porque no distingue ese momento.
  # PARA PASAR A ENFORCE: navegar el sitio entero (home, tours, checkout,
  # newsletter), revisar violaciones en consola, corregir, y solo entonces
  # renombrar la cabecera a Content-Security-Policy.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://www.facebook.com https://www.google-analytics.com; connect-src 'self' https://api.frankfurter.app https://script.google.com https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://connect.facebook.net; frame-src https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
</IfModule>

# ── 2. Sin listado de directorios ──────────────────────────────────
Options -Indexes

# ── 2.bis Página de error propia (14-oct-2026) ─────────────────────
# Sin esto, cualquier dirección inexistente la contestaba la página por
# defecto del alojamiento, que carga Google Fonts, un Google Analytics de
# otra cuenta y doubleclick sin aviso de cookies. /404.html es nuestra:
# fuentes locales y nada de terceros sin consentimiento. La ruta va desde
# la raíz porque se sirve para cualquier profundidad.
ErrorDocument 404 /404.html

# ── 2.ter Caché de las fuentes propias (14-oct-2026) ───────────────
# Los woff2 de /fonts/ no cambian nunca con el mismo nombre (una fuente
# nueva es un fichero nuevo), así que se guardan un año, como hacía Google
# Fonts. Sin esta regla valen los 7 días que da el alojamiento a todo lo
# estático. fonts.css se queda en esos 7 días a propósito: es lo que
# cambiaría si se toca un @font-face.
<IfModule mod_headers.c>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── 3. Ficheros que nunca deben servirse en público ────────────────
# A02:2025 — "ficheros olvidados" es el hallazgo top de los escáneres.
# `csv` incluido: private/itinerary_subscribers.csv son datos personales
# (email, IP, user-agent) — una fuga ahí es brecha RGPD/UU PDP.
# OJO: data.json NO se bloquea — es el CMS que carga el front (fetch).
#      Los .txt tampoco — robots.txt, llms.txt y la clave IndexNow.
<FilesMatch "\.(md|sql|zip|bak|log|csv|sh|ini|yml|yaml|psd|ai)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# ── 4. Ficheros de backup sueltos en la raíz ───────────────────────
# `.gitignore` usa `Backup_*/` (solo carpetas): un backup suelto tipo
# Backup_2026_checkout.php sí se subiría. Esto lo corta igual.
<FilesMatch "(?i)^(backup|backups)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# `_compartido/` (6-ago-2026): fuente de nav/footer por familia para
# `tools/estampar_bloques.py` — fragmentos HTML sueltos, sin <head> ni
# contenido, que nunca deben servirse por su cuenta. Cazado por Legal en
# la consulta de deploy de esta misma sesión: sin esta regla respondían
# 200 en producción.
# ── 5. Control de versiones, backups y carpeta privada ─────────────
# `/private/` ya tiene su propio .htaccess en el servidor, PERO `private/`
# está gitignored → ese fichero no lo repone ningún deploy. Si un wipe o
# una reconexión de Git en hPanel lo borra (le pasó a Lawang el 8-jul-2026),
# el CSV de suscriptores queda al aire. Esta regla SÍ está versionada.
RedirectMatch 404 (?i)/\.git
RedirectMatch 404 (?i)/private/
RedirectMatch 404 (?i)/(Backups?|Deprecated|masters|MetaLead|_compartido)/

# ── URLs limpias: /terms en vez de /terms.html ─────────────────────
# Solo raiz y solo GET a proposito: las subcarpetas (api/, private/) son endpoints
# con POST, y un 301 convierte un POST en GET — ahi romperia los formularios.
# Cuidado al anadir alias: mod_rewrite corre ANTES que mod_alias, asi que un
# "Redirect" hacia un .html se lo come la regla 1 y acaba en 404. Van como RewriteRule.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) La URL con extension redirige a la limpia: una sola URL indexable.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+index\.html[\s?]" [NC]
  RewriteRule ^ / [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} "\s/+([^/\s?]+?)\.(html|php)[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) La URL limpia sirve el fichero real sin que el navegador vea la extension.
  #    ^([^/.]+)$ = solo raiz y sin puntos: data.json, robots.txt y assets no entran.
  #    /404 queda fuera: si entrara, la pagina de error se serviria con codigo 200
  #    ("pagina encontrada"). Sin fichero que servir da un 404 de verdad, y
  #    ErrorDocument pone 404.html con el codigo correcto.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteCond %{REQUEST_URI} !^/404$
  RewriteRule ^([^/.]+)$ $1.html [L]
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^/.]+)$ $1.php [L]
</IfModule>
